# Production settings. Copy to deploy/.env on the server and fill in.
# Never commit deploy/.env.

# The public address. Point its DNS A record at the server first.
DOMAIN=careerlens.example.com

# Database. Use a long random password, e.g.: openssl rand -base64 32
POSTGRES_USER=careerlens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=careerlens

# Accounts. Create your own account, then set this to false and restart the
# backend so strangers can't sign up.
ALLOW_REGISTRATION=true

# Optional AI (Google Gemini). Leave empty to run on the rule engine only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Only for a plain-http test on your own machine (DOMAIN=:80):
# COOKIE_SECURE=false
# HTTP_PORT=8080

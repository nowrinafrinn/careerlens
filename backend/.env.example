# Copy to backend/.env. Never commit the real .env.
APP_ENV=development

# psycopg 3 driver ("postgresql+psycopg"). Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+psycopg://careerlens:careerlens@localhost:5432/careerlens
# pytest runs migrations and tests here; it is never your real data.
TEST_DATABASE_URL=postgresql+psycopg://careerlens:careerlens@localhost:5432/careerlens_test

# Auth
SESSION_TTL_DAYS=14
# true in any deployment (HTTPS only); false for http://localhost
COOKIE_SECURE=false
ALLOW_REGISTRATION=true

# Optional AI (Google Gemini). Leave GEMINI_API_KEY empty to run on the rule engine only.
# Get a key at https://aistudio.google.com/apikey. It stays on the server.
# On the free tier Google may use what it receives to improve its products:
# test with made-up CVs, not real ones.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Copy to backend/.env. Never commit the real .env.
APP_ENV=development

# psycopg 3 driver ("postgresql+psycopg"). Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+psycopg://careerlens:careerlens@localhost:5432/careerlens
# pytest runs migrations and tests here; it is never your real data.
TEST_DATABASE_URL=postgresql+psycopg://careerlens:careerlens@localhost:5432/careerlens_test
